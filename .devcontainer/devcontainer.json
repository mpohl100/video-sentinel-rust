{
  "name": "video-sentinel ROS2 Lyrical",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "profile": "minimal",
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    }
  },
  "containerEnv": {
    "EXECUTE_BIN_BASH": "0",
    "RUN_POSTCREATE": "false",
    "ROS_DISTRO": "lyrical",
    "AMENT_PREFIX_PATH": "/opt/ros/lyrical",
    "CMAKE_PREFIX_PATH": "/opt/ros/lyrical",
    "COLCON_PREFIX_PATH": "/opt/ros/lyrical",
    "LD_LIBRARY_PATH": "/opt/ros/lyrical/lib",
    "PYTHONPATH": "/opt/ros/lyrical/lib/python3.14/site-packages"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.git",
        "rust-lang.rust-analyzer",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "arjun.swagger-viewer",
        "ms-iot.vscode-ros"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.path": "/usr/bin/git"
      }
    }
  },
  "postCreateCommand": "bash -lc 'source /opt/ros/lyrical/setup.bash && [ \"$RUN_POSTCREATE\" != \"false\" ] && cargo install cargo-tarpaulin || true'"
}